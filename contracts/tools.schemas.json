{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aidy Tool Contracts (Compiled)",
  "type": "object",
  "tools": {
    "search_products": {
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "constraints": "Free-text search. Max 200 chars."
          },
          "category": {
            "type": "string",
            "constraints": "Exact match on products.category"
          },
          "color": {
            "type": "string",
            "constraints": "Exact match on product_variants.color"
          },
          "size": {
            "type": "string",
            "constraints": "Exact match on product_variants.size"
          },
          "brand": {
            "type": "string",
            "constraints": "Exact match on products.brand"
          },
          "price_max": {
            "type": "number",
            "constraints": "Filter: price <= price_max"
          },
          "in_stock_only": {
            "type": "boolean",
            "constraints": "Default: true. Filter: stock > 0"
          },
          "limit": {
            "type": "integer",
            "constraints": "Default: 5. Range: 1-20."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: Array<{ product_id, variant_id, name, description, category, brand, price, size, color, stock, image_url }>",
        "Access: Read-only. Tenant-scoped. Uses hybrid retrieval: SQL filters \u2192 pg_trgm \u2192 optional rerank."
      ]
    },
    "check_stock": {
      "input_schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string (UUID)",
            "constraints": "Must exist in tenant\u2019s products"
          },
          "variant_id": {
            "type": "string (UUID)",
            "constraints": "If omitted, returns all variants"
          }
        },
        "required": [
          "product_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: { in_stock: bool, quantity: int, variants: Array<{ variant_id, size, color, stock }> }"
      ]
    },
    "add_to_cart": {
      "input_schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string (UUID)",
            "constraints": "Must come from a prior search_products result in this conversation"
          },
          "variant_id": {
            "type": "string (UUID)",
            "constraints": "Required if product has variants"
          },
          "quantity": {
            "type": "integer",
            "constraints": "Range: 1-99"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: Updated cart object { items: [...], item_count, subtotal }",
        "Side effect: Writes to conversations.cart_state ONLY. Does not touch products/stock."
      ]
    },
    "remove_from_cart": {
      "input_schema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string (UUID)",
            "constraints": "Must exist in current cart"
          },
          "variant_id": {
            "type": "string (UUID)",
            "constraints": "If product has variants"
          }
        },
        "required": [
          "product_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: Updated cart object."
      ]
    },
    "calculate_total": {
      "input_schema": {
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string (UUID)",
            "constraints": "Implicit from context (injected by orchestrator)"
          }
        },
        "required": [
          "conversation_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: { items: [{ name, qty, unit_price, line_total }], subtotal, delivery_fee, total }",
        "Execution: DETERMINISTIC Python function. Reads cart_state, queries current prices, applies business rules (delivery fee logic). NO LLM INVOLVEMENT."
      ]
    },
    "create_order": {
      "input_schema": {
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string (UUID)",
            "constraints": "Implicit from context"
          },
          "delivery_name": {
            "type": "string",
            "constraints": "Customer name"
          },
          "delivery_phone": {
            "type": "string",
            "constraints": "E.164 or local format"
          },
          "delivery_address": {
            "type": "string",
            "constraints": "Full address"
          },
          "delivery_city": {
            "type": "string",
            "constraints": ""
          },
          "notes": {
            "type": "string",
            "constraints": "Customer notes"
          },
          "idempotency_key": {
            "type": "string",
            "constraints": "Generated by orchestrator: conv_id + timestamp hash"
          }
        },
        "required": [
          "conversation_id",
          "delivery_name",
          "delivery_phone",
          "delivery_address",
          "delivery_city",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "PRECONDITION: conversations.confirm_state MUST be true. If false, tool returns error and agent must ask for confirmation.",
        "Returns: { order_id, status: 'pending', summary }",
        "Side effects: Creates order + order_items records. Resets cart_state. Sends merchant notification."
      ]
    },
    "get_order_status": {
      "input_schema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string (UUID)",
            "constraints": "Must belong to current customer"
          }
        },
        "required": [
          "order_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: { order_id, status, items, total, created_at, updated_at }"
      ]
    },
    "analyze_image": {
      "input_schema": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string",
            "constraints": "URL to image in Supabase Storage"
          },
          "conversation_summary": {
            "type": "string",
            "constraints": "Last 3 messages summarized (injected by orchestrator)"
          },
          "task": {
            "type": "string",
            "constraints": "Enum: diagnose, identify_product, visual_search"
          }
        },
        "required": [
          "image_url",
          "conversation_summary",
          "task"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Returns: { analysis: string, confidence: float, tags: string[], suggested_products: UUID[] }",
        "Execution: Calls vision model (Gemini Flash). Result is validated, then injected into chat model context."
      ]
    },
    "escalate_to_human": {
      "input_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "constraints": "Why the agent is escalating"
          },
          "conversation_id": {
            "type": "string (UUID)",
            "constraints": "Implicit from context"
          }
        },
        "required": [
          "reason",
          "conversation_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "description": "Canonical response fields are partially specified in invariants/appendix; unresolved fields remain open.",
        "additionalProperties": true
      },
      "invariants": [
        "Side effects: Sets conversation.mode = 'manual'. Sends dashboard notification + optional WhatsApp message to merchant."
      ]
    }
  }
}
